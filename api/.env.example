# =============================================================================
# CentralBank API Gateway Configuration
# =============================================================================

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Blockchain Connection
# Lab environment - local Besu node
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=31337

# Protocol stack: v1 (DigitalToken path, default) or v2 (TokenLedgerV2 + controllers)
PROTOCOL_STACK=v1

# Contract Addresses — v1 (required when PROTOCOL_STACK=v1)
CONTRACT_PERMISSIONING=0x...
CONTRACT_WALLET_REGISTRY=0x...
CONTRACT_DIGITAL_TOKEN=0x...
CONTRACT_CONDITIONAL_PAYMENTS=0x...

# Contract Addresses — Protocol v2 (required when PROTOCOL_STACK=v2)
# CONTRACT_TOKEN_LEDGER_V2=0x...
# CONTRACT_MINT_BURN_CONTROLLER_V2=0x...
# CONTRACT_ESCROW_CONTROLLER_V2=0x...
# CONTRACT_WATERFALL_CONTROLLER_V2=0x...
# CONTRACT_SANCTIONS_POLICY_V2=0x...
# CONTRACT_EMERGENCY_POLICY_V2=0x...
# CONTRACT_HOLDING_LIMIT_POLICY_V2=0x...

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
API_KEY_HEADER=X-API-Key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# Operator Keys (for signing transactions)
# WARNING: In production, use HSM or secure key management
BLOCKCHAIN_OPERATOR_PRIVATE_KEY=0x...
# Protocol v2 dual-control pause/unpause (lab: Anvil account #1)
# BLOCKCHAIN_EMERGENCY_PRIVATE_KEY=0x...

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_PATH=/health
