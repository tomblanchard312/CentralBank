{
  "name": "@centralbank/bank-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for institutions integrating with the CentralBank Digital Token Protocol (CBDT)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "centralbank",
    "cbdt",
    "cbdc",
    "blockchain",
    "ethereum",
    "banking",
    "institutional-api",
    "eurosystem-reference"
  ],
  "author": "CentralBank Project",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.9.2",
    "axios": "^1.6.5",
    "zod": "^3.22.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.8",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1"
  }
}
